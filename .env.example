# Copy to .env and adjust. Everything has a safe default for local development.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-for-any-shared-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite is used when DATABASE_URL is not set. For PostgreSQL:
# DATABASE_URL=postgres://ekcode:ekcode@localhost:5432/ekcode
# 1 = show the one-time sign-in code on screen (demo). Set 0 once an SMS gateway sends it.
EK_DEMO_OTP=1
