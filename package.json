{
  "name": "ekcode-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Tailwind CSS and JavaScript build for EkCode",
  "scripts": {
    "build:css": "tailwindcss -i frontend/src/css/app.css -o static/css/app.css --minify",
    "build:js": "node frontend/scripts/build-js.mjs",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i frontend/src/css/app.css -o static/css/app.css --watch"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "tailwindcss": "3.4.17"
  }
}
